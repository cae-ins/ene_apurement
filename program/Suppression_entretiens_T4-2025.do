* -----------------------------------------------------------------------
* Etape 2 : Appliquer la suppression sur chaque fichier brut
* keep(master) = garder uniquement les lignes NON presentes dans keys_to_drop
* -----------------------------------------------------------------------

local brute_files QX_EEC_VF membres Activiteparent disponibilite emigration  ///
    Revenu Revenu_es r_competence_quali r_revenu_h_emp r_activite_s           ///
    VISITE_IND VISITE_ROOSTER couts_biens                                     ///
    interview__actions assignment__actions                                    ///
    interview__comments interview__diagnostics interview__errors

foreach f of local brute_files {
    use "$datain_source/`f'.dta", clear
    cap confirm variable interview__key
    if _rc == 0 {
        merge m:1 interview__key using `keys_to_drop', keep(master) nogen
    }
    else {
        di as text "  -> Pas de interview__key, copie directe : `f'.dta"
    }
    save "$datain_brute/`f'.dta", replace
    di as text "  -> Traite : `f'.dta"
}

* -----------------------------------------------------------------------
* Etape 3 : Diagnostic - repartition des menages par region et ZD
* -----------------------------------------------------------------------

use "$datain_brute/QX_EEC_VF.dta", clear  // diagnostic sur brute (après filtre)

preserve
keep if rgmen == 1
gen zd = 1
collapse (count) zd, by(HH2 HH8 HH8A HH8B)
sort zd
list
restore
